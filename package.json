{
  "name": "first-sight",
  "version": "2.2.0-course",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc --noEmit false --outDir dist/current",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/testing/test-typescript.mjs",
    "test:cam": "cam\\.venv\\Scripts\\python.exe -m unittest discover -s cam/host -p \"test_*.py\" -v",
    "test:docs": "python scripts/testing/check-doc-links.py",
    "demo": "npm run build && node --use-env-proxy dist/current/index.js",
    "demo:tunnel": "npm run build && node --use-env-proxy dist/current/index.js --tunnel",
    "start": "npm run demo"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "5.9.3"
  }
}
